name: Actualizar precios
on:
  schedule: [{ cron: "0 */6 * * *" }]
  workflow_dispatch:
permissions: { contents: write }
jobs:
  precios:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20 }
      - run: node actualizar-precios.js
      - run: |
          git config user.name "precios-bot"; git config user.email "bot@users.noreply.github.com"
          git add prices.json; git diff --cached --quiet || (git commit -m "Actualizar precios" && git push)
